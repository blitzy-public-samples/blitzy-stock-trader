<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.stocktrader</groupId>
    <artifactId>execution-control</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>StockTrader - execution-control</name>
    <description>
        Institutional Execution and Post-Trade Control Hub: a self-contained Open Liberty
        microservice that simulates institutional equity order handling - configurable
        pre-trade controls, simulated executions, settlement-exception (SSI mismatch)
        workflow and an append-only audit timeline - over in-memory synthetic data.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <app.name>execution-control</app.name>
        <warContext>${app.name}</warContext>

        <!-- The two port properties are written into the test server's variable
             configuration, where src/main/liberty/config/server.xml declares matching
             <variable> elements; overriding them on the command line therefore moves the
             server listener and the Failsafe liberty.test.port together. -->
        <liberty.var.default.http.port>9080</liberty.var.default.http.port>
        <liberty.var.default.https.port>9443</liberty.var.default.https.port>
        <liberty.env.AUTH_TYPE>none</liberty.env.AUTH_TYPE>
        <liberty.env.JWT_AUDIENCE>stock-trader</liberty.env.JWT_AUDIENCE>
        <liberty.env.JWT_ISSUER>http://stock-trader.ibm.com</liberty.env.JWT_ISSUER>

        <sonar.organization>ibmstocktrader</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- 7.1 deliberately matches the microProfile-7.1 feature server.xml enables,
                 so the compile-time API cannot drift from the runtime. -->
            <groupId>org.eclipse.microprofile</groupId>
            <artifactId>microprofile</artifactId>
            <version>7.1</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Supplies io.opentelemetry.instrumentation.annotations.WithSpan, matching
                 the mpTelemetry-2.1 feature server.xml enables. -->
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-api</artifactId>
            <version>2.1</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-rt-rs-client</artifactId>
            <version>4.1.8</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Runtime requirement of the CXF client. -->
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>4.0.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <version>2.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>1.1.9</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Load-bearing: target/ExecutionControl.war is the name server.xml loads via
             <webApplication location="ExecutionControl.war"/>, the file the Dockerfile
             copies into apps/, and the artefact liberty:deploy installs for the ITs. -->
        <finalName>ExecutionControl</finalName>
        <!-- Plugin versions are a security floor as much as a feature choice. maven-war-plugin
             3.5.1, maven-compiler-plugin 3.16.0, maven-resources-plugin 3.5.0 and
             liberty-maven-plugin 3.12.3 are the releases whose own dependencies drop the
             advisory-bearing commons-io, plexus-archiver, commons-compress, commons-lang3 and
             jackson-core artefacts the earlier pins put on the build classpath. None of those
             artefacts ships in the WAR or the image, so the exposure is the build host - which is
             where the estate's release engineering happens. Where no release of a plugin ships a
             fixed transitive, the artefact is pinned on the plugin itself below. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <packagingExcludes>pom.xml</packagingExcludes>
                    <archive>
                        <!-- Without this the plugin writes META-INF/maven/<groupId>/<artifactId>/
                             pom.xml and pom.properties into the WAR, handing anyone who obtains
                             the deployed artefact a version-precise inventory of every dependency
                             it was built against. packagingExcludes cannot remove them: they are
                             added by the archiver, not copied from the webapp source - which is
                             also why the flag belongs to <archive> and is ignored (with a warning)
                             directly under <configuration>. Liberty never reads META-INF/maven,
                             so nothing at runtime depends on them. -->
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
                <dependencies>
                    <!-- 3.5.1 resolves plexus-utils 4.0.2, one patch below the 4.0.3 that fixes
                         CVE-2025-67030 (Expand.extractFile writes outside the extraction
                         directory), so the fixed artefact is pinned rather than waited for. 4.0.3
                         is also what liberty-maven-plugin and maven-compiler-plugin resolve, so
                         one version of plexus-utils covers the whole build. -->
                    <dependency>
                        <groupId>org.codehaus.plexus</groupId>
                        <artifactId>plexus-utils</artifactId>
                        <version>4.0.3</version>
                    </dependency>
                    <!-- 3.5.1 resolves plexus-archiver 4.10.4, whose own compressor dependency is
                         io.airlift:aircompressor 0.27 - CVE-2025-67721, where a reused output
                         buffer leaks bytes of an earlier stream. 4.14.0 drops that dependency
                         altogether rather than upgrading it, so the coordinate leaves the build
                         classpath instead of moving to a patched version. Pinning the archiver is
                         also what keeps commons-compress and commons-io current underneath it.
                         The WAR is written by this archiver, so a packaged artefact is proof the
                         pin holds. -->
                    <dependency>
                        <groupId>org.codehaus.plexus</groupId>
                        <artifactId>plexus-archiver</artifactId>
                        <version>4.14.0</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <!-- release (not source/target) so the JDK 17 API surface is enforced
                         even when the build runs on a newer JDK. -->
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <dependencies>
                    <!-- Its newest release still resolves plexus-utils 3.6.0, below both fixes
                         for CVE-2025-67030 (3.6.1 and 4.0.3), so the artefact is pinned here for
                         the same reason it is pinned on the war plugin. -->
                    <dependency>
                        <groupId>org.codehaus.plexus</groupId>
                        <artifactId>plexus-utils</artifactId>
                        <version>4.0.3</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- Declared before Surefire because Surefire consumes the agent argLine this
                 plugin publishes. The agent is published under the named property
                 jacocoArgLine rather than the default argLine so only Surefire opts in:
                 the Failsafe fork stays uninstrumented and can never overwrite
                 target/jacoco.exec with client-side coverage. Coverage is therefore
                 measured in the unit-test JVM alone; the Liberty JVM is not instrumented. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <dependencies>
                    <!-- The version stays: no JaCoCo release, 0.8.13 or later, ships a fixed
                         plexus-utils or commons-io, so a bump would move the plugin without
                         closing anything. Pinned instead are plexus-utils 4.0.3 (CVE-2025-67030,
                         Expand.extractFile path traversal - 0.8.13 resolves 3.0.24) and
                         commons-io 2.22.0 (CVE-2024-47554, unbounded XmlStreamReader consumption
                         - 0.8.13 resolves 2.11.0). Coverage instrumentation, the report and the
                         check rule all exercise these, so the gate proves the pins. -->
                    <dependency>
                        <groupId>org.codehaus.plexus</groupId>
                        <artifactId>plexus-utils</artifactId>
                        <version>4.0.3</version>
                    </dependency>
                    <dependency>
                        <groupId>commons-io</groupId>
                        <artifactId>commons-io</artifactId>
                        <version>2.22.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.ibm.hybrid.cloud.sample.stocktrader.executioncontrol.control</include>
                                        <include>com.ibm.hybrid.cloud.sample.stocktrader.executioncontrol.lifecycle</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Unit tests (*Test). Bound explicitly so the phase cannot be lost. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <!-- @{...} defers evaluation to execution time, when the JaCoCo agent
                         path published at initialize is available. -->
                    <argLine>@{jacocoArgLine}</argLine>
                    <useModulePath>false</useModulePath>
                </configuration>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- A real Liberty server is created and has its features installed before
                 packaging finishes, started once the WAR exists, and stopped after the
                 ITs - so the *IT classes always run against a running service. -->
            <plugin>
                <groupId>io.openliberty.tools</groupId>
                <artifactId>liberty-maven-plugin</artifactId>
                <version>3.12.3</version>
                <executions>
                    <execution>
                        <id>install-feature</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>create</goal>
                            <goal>install-feature</goal>
                        </goals>
                        <configuration>
                            <features>
                                <feature>microProfile-7.1</feature>
                                <feature>mpTelemetry-2.1</feature>
                                <feature>appSecurity-5.0</feature>
                            </features>
                        </configuration>
                    </execution>
                    <execution>
                        <id>start-server</id>
                        <phase>pre-integration-test</phase>
                        <!-- deploy before test-start, so the freshly packaged WAR is in the
                             server's apps directory before the server boots and the application
                             the ITs meet is started exactly once. Started the other way round, a
                             build that reuses a target/ directory boots the previous run's WAR,
                             deploy's search for the application-started message matches that
                             start instead of the new artefact's, and copying the new WAR then
                             restarts the application underneath the running tests - every path
                             under the context root answering 404 while it does. -->
                        <goals>
                            <goal>deploy</goal>
                            <goal>test-start</goal>
                        </goals>
                        <configuration>
                            <looseApplication>false</looseApplication>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stop-server</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>test-stop</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Held at the release the Dockerfile's base image runs, so the ITs cannot
                         pass on a runtime the container does not have. The full runtime
                         assembly is used because the Web Profile one publishes no release
                         past 26.0.0.4, which is still inside the servlet request-smuggling
                         advisory range. -->
                    <assemblyArtifact>
                        <groupId>io.openliberty</groupId>
                        <artifactId>openliberty-runtime</artifactId>
                        <version>26.0.0.9</version>
                        <type>zip</type>
                    </assemblyArtifact>
                    <configDirectory>${basedir}/src/main/liberty/config</configDirectory>
                    <features>
                        <acceptLicense>true</acceptLicense>
                    </features>
                    <!-- Deploy the packaged WAR itself: a loose application would expose
                         target/classes instead of the artefact the image ships. -->
                    <looseApplication>false</looseApplication>
                    <stripVersion>true</stripVersion>
                </configuration>
            </plugin>
            <!-- Integration tests (*IT). Both goals are bound, so verify fails the build
                 on any IT failure. No argLine here - see the JaCoCo comment above. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.4</version>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <liberty.test.port>${liberty.var.default.http.port}</liberty.test.port>
                        <!-- Must equal the context root declared in server.xml and
                             ibm-web-ext.xml: the ITs build their application root as
                             http://localhost:{liberty.test.port}/{war.context}. -->
                        <war.context>${warContext}</war.context>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Opt-in software-composition analysis over this module's own coordinates. Deliberately
             outside the default build: the goal needs an NVD API key and a populated local
             vulnerability database, so wiring it into `verify` would fail every build that has
             neither for a reason unrelated to this module's code. Run it on purpose:

                 NVD_API_KEY=<key> mvn -B -Pdependency-check dependency-check:check

             It reports rather than gates (failBuildOnCVSS keeps the plugin default of 11, which
             no score can exceed); pass -DfailBuildOnCVSS=7 to make it fail on a High finding.
             The full procedure, and the substitute when no key is available, are in the README
             under "Dependency and image scanning". -->
        <profile>
            <id>dependency-check</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>13.0.0</version>
                        <configuration>
                            <!-- The key arrives from the environment, never as a POM value or a
                                 -DnvdApiKey argument: Maven echoes plugin configuration in debug
                                 output, which is the exposure GHSA-qqhq-8r2c-c3f5 describes. -->
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                            <!-- The plugin skips test scope by default, which would leave out the
                                 REST client and JSON parser this module's tests bring in - two of
                                 the three coordinates its supply-chain review has moved so far. -->
                            <skipTestScope>false</skipTestScope>
                            <formats>HTML,JSON</formats>
                            <!-- Analyzers for ecosystems this module has no files in. Off so a
                                 scan neither reports on them nor depends on their toolchains or
                                 on advisory feeds fetched from outside Maven Central. -->
                            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                            <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                            <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sca</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
