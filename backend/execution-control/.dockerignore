# Runtime-only image fed by a WAR Maven has already built, so the context is restricted to the Liberty server configuration and that WAR: exclude everything, then re-include only what the Dockerfile copies (last matching pattern wins).
*

# Serves COPY src/main/liberty/config -> defaultServer/; every ancestor must be re-included before the leaf, or the leaf is unreachable.
!src
!src/main
!src/main/liberty
!src/main/liberty/config
!src/main/liberty/config/**

# Serves COPY target/ExecutionControl.war -> defaultServer/apps/, the artefact name pom.xml pins with <finalName>ExecutionControl</finalName>.
!target
!target/ExecutionControl.war

# Re-including src and target re-admits their whole subtrees by parent match, so what the image does not need is excluded again here, after the re-includes, where a later broadening of them cannot readmit it.
# Only siblings of the two wanted paths may appear below: a pattern matching an ancestor of src/main/liberty/config would win last and take the configuration out with it.
src/main/java
src/main/resources
src/main/webapp
src/test

# target/liberty is the installed Liberty test server (the largest item) and target/ExecutionControl the exploded WAR; both are anchored patterns, so neither matches target/ExecutionControl.war itself.
target/liberty
target/classes
target/test-classes
target/surefire-reports
target/failsafe-reports
target/site
target/jacoco.exec
target/ExecutionControl
target/maven-archiver
target/maven-status
target/generated-sources
target/generated-test-sources
target/liberty-plugin-config.xml
**/.git
**/.idea
**/.vscode
**/*.iml
**/*.log
